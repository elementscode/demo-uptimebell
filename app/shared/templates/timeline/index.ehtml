import "./style.css";
import { Badge } from "@elements/ui/badge";
import { IncidentUpdate } from "#app/shared/services/incidents";
import { formatDateTime } from "#app/shared/format";

export function incidentIntent(status: string): "success" | "warning" | "danger" {
  return status === "resolved" ? "success" : status === "identified" ? "warning" : "danger";
}

<IncidentPill (status: string)>
  <Badge variant={incidentIntent(status)} dot class="capitalize">{status}</Badge>
</IncidentPill>

<Timeline (updates: IncidentUpdate[])>
  <ol class="timeline">
    <li e:for={update of updates} class="timeline-item">
      <span class={["timeline-status", `is-${update.status}`]}>{update.status}</span>
      <div>
        <p>{update.body}</p>
        <span class="timeline-time">{formatDateTime(update.createdAt)}</span>
      </div>
    </li>
  </ol>
</Timeline>
