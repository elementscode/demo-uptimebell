import "./style.css";
import { redirect } from "@elements/app";
import { signup, slugify, MIN_PASSWORD, SignupForm } from "#app/shared/services/auth";
import { Brand } from "#app/shared/templates/layout";

interface SignupState {
  fields: SignupForm;
  error: string;
  busy: boolean;
}

function onSubmit(state: SignupState) {
  state.busy = true;

  try {
    signup(state.fields);
    state.error = "";
    redirect("/dashboard");
  } catch (err: any) {
    state.error = err.message;
    state.busy = false;
  }
}

<html lang="en" class="page-signup" (
  private state: SignupState = { fields: { name: "", email: "", password: "" }, error: "", busy: false },
)>
  <head>
    <title>Create an account · uptimebell</title>
    <meta name="description" content="Create an uptimebell account">
  </head>
  <body>
    <main class="auth">
      <div class="auth-column stack is-lg">
        <div class="auth-intro stack is-sm">
          <div><Brand href="/signin"/></div>
          <p>Add a url, and we check it every minute.</p>
        </div>

        <div class="card">
          <div class="card-body">
            <form class="stack" onsubmit={() => onSubmit(state)}>
              <h1 class="text-xl">Create an account</h1>

              <p e:if={state.error} class="error" role="alert">{state.error}</p>

              <div class="field">
                <label for="name">Company or project</label>
                <input id="name" name="name" value={state.fields.name} autocomplete="organization" placeholder="Acme" required>
                <p class="hint" e:if={slugify(state.fields.name)}>Status page at /status/{slugify(state.fields.name)}</p>
              </div>

              <div class="field">
                <label for="email">Email</label>
                <input id="email"
                       name="email"
                       type="email"
                       value={state.fields.email}
                       autocomplete="email"
                       autocapitalize="none"
                       spellcheck={false}
                       placeholder="you@company.com"
                       required>
              </div>

              <div class="field">
                <label for="password">Password</label>
                <input id="password"
                       name="password"
                       type="password"
                       value={state.fields.password}
                       autocomplete="new-password"
                       minlength={MIN_PASSWORD}
                       required>
                <p class="hint">At least {MIN_PASSWORD} characters</p>
              </div>

              <button type="submit" class={["is-primary is-block", state.busy && "is-loading"]} disabled={state.busy}>Create account</button>
            </form>
          </div>
        </div>

        <p class="auth-switch">Have an account? <a href="/signin">Sign in</a></p>
      </div>
    </main>
  </body>
</html>
