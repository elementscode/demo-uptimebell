import "./chart.css";
import type { ChartConfig } from "@elements/ui/chart";
import { AreaChart } from "@elements/ui/chart-area";
import { Empty } from "@elements/ui/empty";
import { ChartPoint, BUCKET_MS } from "#app/shared/services/monitors";
import { formatMs, formatTime } from "#app/shared/format";

const BUCKETS = (24 * 60 * 60 * 1000) / BUCKET_MS;

export type ChartRow = {
  slot: number;
  t: number;
  ms: number | null;
  failed: number | null;
  checks: number;
  failures: number;
};

export interface Chart {
  rows: ChartRow[];
  yMax: number;
  empty: boolean;
}

function niceMax(value: number): number {
  let steps = [50, 100, 200, 250, 500, 750, 1000, 1500, 2000, 3000, 5000, 10000];

  return steps.find((step) => step >= value * 1.15) ?? Math.ceil(value / 1000) * 1000;
}

/**
 * Lays the last 24 hours out as one row per ten minute bucket. A bucket with
 * no checks, or where every check timed out, has no response time, so the
 * line breaks there rather than drawing a fall to zero. A bucket with a
 * failed check fills the full height of the plot in the danger color.
 */
export function buildChart(series: ChartPoint[]): Chart {
  let end = series.length > 0 ? series[series.length - 1].t : Math.floor(Date.now() / BUCKET_MS) * BUCKET_MS;
  let start = end - (BUCKETS - 1) * BUCKET_MS;
  let yMax = niceMax(Math.max(100, ...series.map((point) => point.ms ?? 0)));
  let byTime = new Map(series.map((point) => [point.t, point]));
  let rows: ChartRow[] = [];

  for (let slot = 0; slot < BUCKETS; slot++) {
    let t = start + slot * BUCKET_MS;
    let point = byTime.get(t);

    rows.push({ slot, t, ms: point?.ms ?? null, failed: null, checks: point?.checks ?? 0, failures: point?.failures ?? 0 });
  }

  // A failed bucket fills the slot that ends at it: the band runs from the
  // row before it to its own row, so a lone failure still has a width.
  for (let slot = 0; slot < BUCKETS; slot++) {
    if (rows[slot].failures > 0) {
      rows[slot].failed = yMax;

      if (slot > 0) {
        rows[slot - 1].failed = yMax;
      }
    }
  }

  return { rows, yMax, empty: series.length === 0 };
}

const config: ChartConfig = {
  ms: { label: "Response", color: "var(--accent)" },
  failed: { label: "Failed", color: "var(--danger)", tooltipType: "none", legendType: "none", strokeOpacity: 0 },
};

function slotLabel(slot: number): string {
  return slot === 0 ? "24h ago" : slot === BUCKETS / 2 ? "12h ago" : "now";
}

function rowLabel(row: ChartRow): string {
  return `avg · ${formatTime(new Date(row.t))}–${formatTime(new Date(row.t + BUCKET_MS))}`;
}

function rowFooter(row: ChartRow): string {
  return row.failures > 0 ? `${row.failures} of ${row.checks} checks failed` : "";
}

<ResponseChart (chart: Chart, label: string)>
  <Empty e:if={chart.empty} variant="muted" description="Waiting for the first check" class="chart-waiting"/>
  <AreaChart e:else
             data={chart.rows}
             {config}
             x="slot"
             series={["failed", "ms"]}
             class="response-chart"
             label={`Response time for ${label} over the last 24 hours`}
             categoryAxis={{ ticks: [0, BUCKETS / 2, BUCKETS - 1], tickFormatter: (value: any) => slotLabel(Number(value)), tickLine: false, showAll: true }}
             valueAxis={{ domain: [0, chart.yMax], ticks: [chart.yMax], tickFormatter: (value: any) => formatMs(Number(value)), mirror: true, tickLine: false, axisLine: false }}
             tooltip={{
               labelFormatter: (_label: any, row: any) => rowLabel(row as ChartRow),
               formatter: (value: any) => formatMs(value as number | null),
               footer: (row: any) => rowFooter(row as ChartRow),
             }}/>
</ResponseChart>
