import "./style.css";

/**
 * Sent to the account when three failed checks in a row open an incident.
 *
 * @email
 */
<html (
  accountName: string,
  monitorName: string,
  url: string,
  reason: string,
  incidentId: string,
)>
  <body class="email incident-opened">
    <div class="email-wrap">
      <p class="badge">Incident opened</p>
      <h1>{monitorName} is down</h1>
      <p>
        <strong>{url}</strong> failed three checks in a row. The last one
        reported: {reason}.
      </p>
      <p>
        We opened an incident on your status page. Post an update so your
        subscribers know what is happening.
      </p>
      <p><a class="cta" href={`/incidents/${incidentId}`}>Post an update</a></p>

      <div class="email-footer">
        <p>uptimebell monitors for {accountName}</p>
      </div>
    </div>
  </body>
</html>
