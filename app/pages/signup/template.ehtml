import "./style.css";
import { redirect } from "@elements/app";
import { signup, slugify, MIN_PASSWORD, SignupForm } from "#app/shared/services/auth";
import { Brand } from "#app/shared/templates/layout";
import { Button } from "@elements/ui/button";
import { Alert } from "@elements/ui/alert";
import { Card, CardContent } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";

interface SignupState {
  fields: SignupForm;
  error: string;
  busy: boolean;
}

function onSubmit(state: SignupState) {
  state.busy = true;

  try {
    signup(state.fields);
    state.error = "";
    redirect("/dashboard");
  } catch (err: any) {
    state.error = err.message;
    state.busy = false;
  }
}

<html lang="en" class="page-signup" (
  private state: SignupState = { fields: { name: "", email: "", password: "" }, error: "", busy: false },
)>
  <head>
    <title>Create an account · uptimebell</title>
    <meta name="description" content="Create an uptimebell account">
  </head>
  <body>
    <main class="auth">
      <div class="auth-column stack is-lg">
        <div class="auth-intro stack is-sm">
          <div><Brand href="/signin"/></div>
          <p>Add a url, and we check it every minute.</p>
        </div>

        <Card>
          <CardContent>
            <form class="stack" onsubmit={() => onSubmit(state)}>
              <h1 class="text-xl">Create an account</h1>

              <Alert e:if={state.error} variant="danger" description={state.error}/>

              <Field label="Company or project" description={slugify(state.fields.name) ? `Status page at /status/${slugify(state.fields.name)}` : ""} required>
                <Input name="name" value={state.fields.name} placeholder="Acme" attrs={{ id: "name", autocomplete: "organization" }}/>
              </Field>

              <Field label="Email" required>
                <Input type="email"
                       name="email"
                       value={state.fields.email}
                       placeholder="you@company.com"
                       attrs={{ id: "email", autocomplete: "email", autocapitalize: "none", spellcheck: "false" }}/>
              </Field>

              <Field label="Password" description={`At least ${MIN_PASSWORD} characters`} required>
                <Input type="password"
                       name="password"
                       value={state.fields.password}
                       attrs={{ id: "password", autocomplete: "new-password", minlength: MIN_PASSWORD }}/>
              </Field>

              <Button type="submit" variant="primary" block loading={state.busy}>Create account</Button>
            </form>
          </CardContent>
        </Card>

        <p class="auth-switch">Have an account? <a href="/signin">Sign in</a></p>
      </div>
    </main>
  </body>
</html>
